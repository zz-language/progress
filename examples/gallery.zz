// Gallery: every style + readout, deterministic (pipe-runnable,
// native-parity check). `live` runs one spinner; `spin` showcases all
// nineteen for ~3 seconds; colors run through std.colors.
import std.colors

import progress.bar
import progress.spin

func demo() {
    println(colors.bold("progress gallery"))
    println("blocks:   " + bar.blocks(0.625, 8))
    println("partial:  " + bar.partial(0.625, 8))
    println("shaded:   " + bar.shaded(0.625, 8))
    println("ascii:    " + bar.ascii(0.625, 8))
    println("arrow:    " + bar.arrow(0.625, 8))
    println("dots:     " + bar.dots(0.625, 8))
    println("thin:     " + bar.thin(0.625, 8))
    println("circle:   " + bar.circle(0.625, 8))
    println("squares:  " + bar.squares(0.625, 8))
    println("spectrum: " + bar.spectrum(0.625, 8))
    println("marquee:  " + bar.marquee(3, 8, 2))
    println("stages:   " + bar.stages(3, 5))
    println("gradient: " + bar.gradient(0.625, 8))
    println("pct: " + bar.pct(0.625) + " count: " + bar.count(30, 48))
    println("rate: " + bar.rate(30, 2000) + " eta: " + bar.eta(30, 48, 2000))
    o := bar.defaults()
    println(bar.line(o, 30, 48, 2000))
    v := bar.vbar(0.5, 4)
    i := 0
    while i < len(v) {
        println("v: " + v[i])
        i = i + 1
    }
    println("spin dots[0]: " + spin.at(1, 0))
    println("spin line[2]: " + spin.at(2, 2))
    println("spin arc colored: " + colors.cyan(spin.at(14, 0)))
    println("spin star colored: " + colors.yellow(spin.at(19, 4)))
    oc := bar.defaults()
    oc.fg = 10
    oc.label = "colored"
    println(bar.render(oc, 0.625))
    println(colors.green("gallery_ok"))
}

func live() {
    ms := spin.run("working", 1, 6, 120)
    println("did " + str(ms) + " ticks")
}

func showcase() {
    s := 1
    while s <= 19 {
        _ := spin.run("style " + str(s), s, 2, 80)
        s = s + 1
    }
    println("showcase done")
}

func main(args: [str]) {
    if len(args) > 0 && args[0] == "live" {
        live()
    } else {
        if len(args) > 0 && args[0] == "spin" {
            showcase()
        } else {
            demo()
        }
    }
}

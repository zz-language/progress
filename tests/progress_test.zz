// Exact-string tests for every renderer, readout, and spinner frame.
import progress.bar
import progress.spin

@test
func styles_pin() {
    assert_eq(bar.blocks(0.625, 8), "[█████░░░]")
    assert_eq(bar.ascii(0.5, 4), "[##--]")
    assert_eq(bar.dots(1.0, 2), "[●●]")
    assert_eq(bar.thin(0.0, 3), "[···]")
    assert_eq(bar.arrow(0.5, 4), "[==>.]")
    assert_eq(bar.shaded(0.5, 4), "[██░░]")
    assert_eq(bar.blocks(0.0, 0), "[]")
    assert_eq(bar.blocks(2.0, 2), "[██]")
}

@test
func partial_circle_pin() {
    assert_eq(bar.partial(0.0, 2), "[░░]")
    assert_eq(bar.circle(0.0, 2), "[○○]")
    assert_eq(bar.circle(1.0, 2), "[●●]")
}

@test
func vertical_pins() {
    v := bar.vbar(0.5, 4)
    assert_eq(len(v), 4)
    assert_eq(v[0], "░")
    assert_eq(v[2], "█")
    assert_eq(v[3], "█")
}

@test
func readouts_pin() {
    assert_eq(bar.pct(0.625), "62.5%")
    assert_eq(bar.pct(2.0), "100.0%")
    assert_eq(bar.count(12, 48), "12/48")
    assert_eq(bar.rate(10, 0), "--/s")
    assert_eq(bar.eta(0, 48, 100), "--:--")
    assert_eq(bar.eta(24, 48, 1000), "00:01")
    assert_eq(bar.clock(61000), "01:01")
}

@test
func image_styles_pin() {
    assert_eq(bar.squares(0.5, 4), "[■■□□]")
    assert_eq(bar.stages(3, 5), "●●●○○ 3/5")
    assert_eq(bar.marquee(0, 6, 2), "[██    ]")
    assert_eq(bar.marquee(4, 6, 2), "[    ██]")
    assert_eq(bar.marquee(6, 6, 2), "[  ██  ]")
    assert_eq(bar.transfer("dl", 1, 25, 4), "dl [□□□□] 1|25 4.0%")
    assert_eq(bar.spectrum(1.0, 1), "[\e[48;2;0;255;0m \e[0m]")
}

@test
func composer_pins() {
    o := bar.defaults()
    assert_eq(bar.render(o, 0.5), "[██████████░░░░░░░░░░] 50.0%")
    o2 := bar.defaults()
    o2.label = "dl"
    o2.count = 1
    assert_eq(bar.line(o2, 12, 48, 0), "dl [█████░░░░░░░░░░░░░░░] 25.0% 12/48")
}

@test
func spinner_frames_pin() {
    assert_eq(len(spin.frames(1)), 10)
    assert_eq(spin.at(1, 0), "⠋")
    assert_eq(spin.at(1, 10), "⠋")
    assert_eq(spin.at(2, 2), "-")
    assert_eq(spin.at(99, 0), "⠋")
    assert_eq(spin.at(9, 4), "→")
    assert_eq(spin.at(12, 0), "☰")
}
